# =============================================================================
# DataBro — .gitignore
# Stack: .NET 9 (backend) + Node/Nuxt 4 pnpm monorepo (frontend).
# Goal: commit source only. Never commit build output, dependencies, secrets,
# local environment files, caches, or IDE/OS cruft.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & local environment  (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local
secrets.json
*.pfx
*.p12
*.pem
*.key
*.crt
# Environment-specific / local app settings (base + Development are tracked as templates)
appsettings.Production.json
appsettings.*.local.json
appsettings.local.json

# -----------------------------------------------------------------------------
# .NET / MSBuild (backend)
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
[Ll]og/
[Ll]ogs/
artifacts/
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
*.user
*.userosscache
*.suo
*.dbmdl
*.pubxml
*.pubxml.user
*.publishproj
PublishScripts/

# Test results & coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResults/
coverage/
*.coverage
*.coveragexml
*.trx
BenchmarkDotNet.Artifacts/

# EF Core / local databases
*.mdf
*.ldf
*.ndf

# -----------------------------------------------------------------------------
# Node / package managers (frontend)
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
jspm_packages/

# -----------------------------------------------------------------------------
# Nuxt / Vite / Nitro build output (frontend)
# -----------------------------------------------------------------------------
.nuxt/
.output/
.nitro/
.data/
dist/
dist-ssr/
.vite/
.turbo/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Local infrastructure / Docker data
# -----------------------------------------------------------------------------
.docker/
docker-data/
*.local

# -----------------------------------------------------------------------------
# IDEs & editors
# -----------------------------------------------------------------------------
.vs/
.idea/
*.iml
# VS Code: ignore local workspace state, keep shared config
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
*.code-workspace
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Python (example content / scripts / notebooks — the domain is Python-heavy)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.ruff_cache/
