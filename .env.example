# DataBro — local development environment (template).
# Copy to `.env` (which is gitignored) and adjust as needed:  cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=databro
POSTGRES_USER=databro
POSTGRES_PASSWORD=databro_dev_pw
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage; stands in for DigitalOcean Spaces) ---
MINIO_ROOT_USER=databro
MINIO_ROOT_PASSWORD=databro_dev_pw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Containerised app services (only used by the `apps` compose profile) ---
API_PORT=5158
SITE_PORT=3000
APP_PORT=3001

# Dev-only JWT signing key for the containerised API. Never reuse in a deployed environment.
JWT_KEY=dev-only-super-secret-signing-key-change-me-please-32b+

# --- Social login (OAuth) ---
# Register two OAuth apps (see docs/LOCAL_DEVELOPMENT.md → "Social login setup") and paste the four
# values here in your own `.env`. Leave these empty in the tracked template — never commit real
# values. Social login is simply unavailable until they are set; the rest of the app runs without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
