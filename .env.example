# DataBro — local development environment (template).
# Copy to `.env` (which is gitignored) and adjust as needed:  cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=databro
POSTGRES_USER=databro
POSTGRES_PASSWORD=databro_dev_pw
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage; stands in for DigitalOcean Spaces) ---
MINIO_ROOT_USER=databro
MINIO_ROOT_PASSWORD=databro_dev_pw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
