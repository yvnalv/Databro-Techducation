<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DataBro.Modules.Media.Application\DataBro.Modules.Media.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\DataBro.Platform.Persistence\DataBro.Platform.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.18">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- S3-compatible object storage: MinIO in dev, DigitalOcean Spaces in production (ADR-0011). -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.415.15" />
    <!-- Fully managed image processing, so the container ships no native imaging dependency.
         Six Labors Split License - free for open source and under $1M revenue (ADR-0011). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- Core only: the module enqueues its own work; the host owns the Hangfire server/storage. -->
    <PackageReference Include="Hangfire.Core" Version="1.8.20" />
  </ItemGroup>

  <ItemGroup>
    <!-- The adapters stay internal to production consumers: nothing outside this assembly should
         reach past IImageProcessor / IMediaStorage. The tests are the exception, because the
         behaviours worth asserting (metadata stripped, polyglot payload gone) are properties of the
         real adapter rather than of the port. -->
    <InternalsVisibleTo Include="DataBro.Modules.Media.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
